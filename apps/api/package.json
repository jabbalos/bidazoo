{
  "name": "@bidazoo/api",
  "version": "0.0.0",
  "private": true,
  "description": "The authoritative BidaZoo API (Fastify modular monolith).",
  "type": "module",
  "exports": {
    "./app": "./src/app.ts",
    "./db": "./src/db.ts",
    "./context": "./src/context.ts",
    "./config": "./src/config.ts",
    "./rate-limit": "./src/http/rate-limit.ts",
    "./identity": "./src/modules/identity/index.ts"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/server.ts",
    "build": "node build.mjs",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "legacy:load": "node --env-file-if-exists=../../.env --import tsx src/cli/legacy-load.ts",
    "legacy:claim-code": "node --env-file-if-exists=../../.env --import tsx src/cli/legacy-claim-code.ts",
    "identity:mail-test": "node --env-file-if-exists=../../.env --import tsx src/cli/mail-test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@bidazoo/contracts": "*",
    "@bidazoo/database": "*",
    "@bidazoo/learning-core": "*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/type-provider-typebox": "^6.2.0",
    "ajv-formats": "^3.0.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "typebox": "^1.3.36"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0"
  }
}
