{
  "name": "@bidazoo/play",
  "version": "0.0.0",
  "private": true,
  "description": "BidaZoo browser shell (Vite). Hosts the game and connects it to the API over HTTP. Presentation only; the server is authoritative.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "build:character-lab": "vite build --mode character-lab --outDir dist-character-lab",
    "preview:character-lab": "vite preview --outDir dist-character-lab"
  },
  "dependencies": {
    "@bidazoo/contracts": "*",
    "@bidazoo/game-sdk": "*",
    "@bidazoo/zoo-sprint": "*"
  },
  "devDependencies": {
    "vite": "^8.3.4"
  }
}
