# BidaZoo environment variables — names and SAFE PLACEHOLDERS only.
# Copy to `.env` (git-ignored) and replace placeholders locally. Never commit real values.

# --- API (server-side only) ---
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001

# PostgreSQL connection string. Replace "change-me" locally; never commit the real one.
DATABASE_URL=postgres://bidazoo:change-me@localhost:5432/bidazoo

# Guest cookie. Defaults to true when NODE_ENV=production, false otherwise. A Secure cookie is
# only sent over HTTPS, and then the cookie name gets the __Host- prefix. Leave unset for local
# http:// development.
# COOKIE_SECURE=true

# Optional comma-separated allowlist of extra origins permitted to make state-changing requests
# (the API always accepts its own origin). Only needed if the client is served from another
# origin. Example: https://play.example.com
# ALLOWED_ORIGINS=

# --- Public-beta protections (Checkpoint D). All optional; the defaults are safe for local use. ---
# Which proxies may set the client address (used by every per-IP limit). Default: none, so
# X-Forwarded-For is ignored and the socket address is used. Behind a reverse proxy, list the
# proxy's address(es), e.g. "loopback" (proxy on the same machine) or "10.0.0.0/8". "true" and hop
# counts are refused on purpose. See docs/SECURITY.md before setting this.
# TRUST_PROXY=

# Rate limits are ON by default. Each rule is RATE_<NAME>_MAX requests per
# RATE_<NAME>_WINDOW_SECONDS. NAMEs: GUEST_CREATE_BURST (per IP), GUEST_CREATE_HOURLY (per IP),
# GLOBAL_GUEST_CREATE (whole service; MAX=0 turns this emergency breaker off), SESSION_START
# (per guest), ANSWER (per guest), API_PER_IP (every /api request from one IP).
# Defaults: 30/60s, 150/3600s, 3000/3600s, 30/600s, 120/60s, 2400/60s.
# RATE_LIMIT_ENABLED=true
# RATE_GUEST_CREATE_BURST_MAX=30
# RATE_GUEST_CREATE_BURST_WINDOW_SECONDS=60
# RATE_CACHE_SIZE=10000

# Strict-Transport-Security max-age in seconds. 0 (default) sends no HSTS header. HSTS is sticky in
# browsers, so enable it only once HTTPS is final. Usually set at the TLS-terminating proxy instead.
# HSTS_MAX_AGE_SECONDS=0

# --- Play client dev/preview server (server-side of Vite, NOT embedded in the bundle) ---
# Where `vite` and `vite preview` forward /api requests. The client always calls /api on its own
# origin, so the guest cookie stays same-origin. Default shown.
# API_PROXY_TARGET=http://127.0.0.1:3001

# --- Family identity (Checkpoint E) ---
# OFF unless IDENTITY_SECRET is set: with it unset no identity route exists and the server is the
# guest-only build. All keys (throttle, codes, PIN pepper) are derived from it; rotating it
# invalidates outstanding device codes and PIN hashes. At least 32 characters:
#   openssl rand -base64 32
# IDENTITY_SECRET=
# Public origin used to build emailed links (never taken from a request Host header). Production
# requires a public https hostname: no localhost, IP address, credentials, path or trailing slash.
# PUBLIC_BASE_URL=http://localhost:5173
# console | file are for development and e2e ONLY and are refused in production. Production
# identity requires MAIL_TRANSPORT=smtp (a provider-neutral SMTP relay); there is no fallback.
# MAIL_TRANSPORT=console
# MAIL_OUTBOX_DIR=./.mail-outbox
# SMTP (MAIL_TRANSPORT=smtp). The sender is a BidaZoo-owned address; the jonabalos.com identity is
# refused. MAIL_FROM is a bare address; the display name is separate. NEVER commit real values.
# MAIL_FROM=no-reply@notify.example.com
# MAIL_FROM_NAME=BidaZoo
# MAIL_SMTP_HOST=
# MAIL_SMTP_PORT=587
# tls (implicit, usually 465) | starttls (must upgrade, usually 587; default) | none (a local dev
# catcher only; refused in production and with credentials)
# MAIL_SMTP_SECURITY=starttls
# MAIL_SMTP_USER=
# MAIL_SMTP_PASSWORD=
# Overall per-message deadline in seconds (1-60). One attempt, no retries.
# MAIL_SMTP_TIMEOUT_SECONDS=10
# Send one harmless test message (no link, no database): npm run identity:mail-test -w @bidazoo/api -- --to you@example.com
# Timings (defaults shown)
# IDENTITY_LINK_MINUTES=15
# IDENTITY_DEVICE_DAYS=90
# IDENTITY_AUTHORITY_HOURS=24
# Durable limits: IDENTITY_RATE_<NAME>_MAX and IDENTITY_RATE_<NAME>_WINDOW_SECONDS, where NAME is
# LOGIN_EMAIL, LOGIN_IP, LOGIN_GLOBAL, LINK_CONSUME_IP, DEVICE_CODE_IP, DEVICE_CODE_GLOBAL,
# CLAIM_CODE_IP, PIN_DEVICE.

# --- Tests only ---
# A throwaway, migrated PostgreSQL database for the integration tests. Tests that touch the
# database SKIP (loudly) when this is unset. NEVER point it at real data: tests create rows.
# TEST_DATABASE_URL=postgres://postgres:change-me@127.0.0.1:5432/bidazoo_test

# Playwright: leave unset for the official run (Playwright's own pinned Chromium).
# Setting it uses a different Chromium and the result is SUPPLEMENTARY only.
# PW_CHROMIUM_EXECUTABLE=
